          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="consumers" parent="1" vertex="1" value="02   EVENT FAN-OUT  /  INDEPENDENT RETRIES BY CONSUMER" style="html=0;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#172c43;overflow=visible;swimlane;startSize=30;rounded=1;arcSize=10;collapsible=0;container=1;recursiveResize=0;fillColor=#f0f4f9;swimlaneFillColor=#f9fbfd;strokeColor=#609e89;fontColor=#215f4c;fontSize=12;fontStyle=1;align=left;spacingLeft=14;verticalAlign=middle;">
