<mxfile host="app.diagrams.net">
  <diagram id="aws-event-driven-microservices" name="Architecture">
    <mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="0" page="1" pageScale="1" pageWidth="1400" pageHeight="684" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="banner" parent="1" vertex="1" value="Event-driven microservices&#10;A committed outbox bridges one database transaction to independently retryable consumers." style="html=0;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#172c43;overflow=visible;rounded=1;arcSize=10;fillColor=#172c43;strokeColor=none;spacingLeft=24;align=left;fontSize=18;fontColor=#ffffff;">
          <mxGeometry x="24" y="20" width="1352" height="102" as="geometry" />
        </mxCell>
        <mxCell id="takeaway" parent="1" vertex="1" value="DESIGN NOTE At-least-once delivery means consumers must be idempotent; a DLQ is a recovery path, not an endpoint." style="html=0;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#172c43;overflow=visible;rounded=1;arcSize=16;fillColor=#eaf0f7;strokeColor=none;spacingLeft=15;align=left;fontSize=13;fontColor=#28425e;fontSize=13;">
          <mxGeometry x="24" y="626" width="1352" height="40" as="geometry" />
        </mxCell>
        <mxCell id="write" parent="1" vertex="1" value="01   COMMAND PATH  /  PUBLISH ONLY AFTER COMMIT" style="html=0;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#172c43;overflow=visible;swimlane;startSize=30;rounded=1;arcSize=10;collapsible=0;container=1;recursiveResize=0;fillColor=#f0f4f9;swimlaneFillColor=#f9fbfd;strokeColor=#d48a38;fontColor=#87440c;fontSize=12;fontStyle=1;align=left;spacingLeft=14;verticalAlign=middle;">
          <mxGeometry x="24" y="140" width="1352" height="138" as="geometry" />
        </mxCell>
        <mxCell id="client" parent="write" vertex="1" value="Client&#10;Via edge/API Gateway or&#10;ALB" style="html=0;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#172c43;overflow=visible;rounded=1;arcSize=13;fillColor=#fff5e7;strokeColor=#d48a38;strokeWidth=1.4;spacing=4;fontSize=12;fontColor=#263b53;">
          <mxGeometry x="24" y="55" width="188" height="60" as="geometry" />
        </mxCell>
        <mxCell id="command" parent="write" vertex="1" value="Command service&#10;Apply business rules" style="html=0;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#172c43;overflow=visible;rounded=1;arcSize=13;fillColor=#eaf7f3;strokeColor=#609e89;strokeWidth=1.4;spacing=4;fontSize=12;fontColor=#263b53;">
          <mxGeometry x="247" y="55" width="188" height="60" as="geometry" />
        </mxCell>
        <mxCell id="transaction" parent="write" vertex="1" value="Service database&#10;Business rows + outbox&#10;in the same transaction" style="html=0;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#172c43;overflow=visible;rounded=1;arcSize=13;fillColor=#f5eff8;strokeColor=#a889b7;strokeWidth=1.4;spacing=4;fontSize=12;fontColor=#263b53;">
          <mxGeometry x="470" y="55" width="188" height="60" as="geometry" />
        </mxCell>
        <mxCell id="relay" parent="write" vertex="1" value="Outbox relay&#10;Publish committed events" style="html=0;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#172c43;overflow=visible;rounded=1;arcSize=13;fillColor=#eaf7f3;strokeColor=#609e89;strokeWidth=1.4;spacing=4;fontSize=12;fontColor=#263b53;">
          <mxGeometry x="693" y="55" width="188" height="60" as="geometry" />
        </mxCell>
        <mxCell id="bus" parent="write" vertex="1" value="EventBridge&#10;Route versioned events" style="html=0;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#172c43;overflow=visible;rounded=1;arcSize=13;fillColor=#ffffff;strokeColor=#a3b1c3;strokeWidth=1.4;spacing=4;fontSize=12;fontColor=#263b53;">
