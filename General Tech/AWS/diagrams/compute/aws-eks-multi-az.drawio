<mxfile host="app.diagrams.net">
  <diagram id="aws-eks-multi-az" name="Architecture">
    <mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="0" page="1" pageScale="1" pageWidth="1400" pageHeight="684" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="banner" parent="1" vertex="1" value="EKS across three Availability Zones&#10;The public ALB forwards HTTP requests directly to Pod IP targets on private worker nodes." style="html=0;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#172c43;overflow=visible;rounded=1;arcSize=10;fillColor=#172c43;strokeColor=none;spacingLeft=24;align=left;fontSize=18;fontColor=#ffffff;">
          <mxGeometry x="24" y="20" width="1352" height="102" as="geometry" />
        </mxCell>
        <mxCell id="takeaway" parent="1" vertex="1" value="DESIGN NOTE The AWS Load Balancer Controller configures the ALB; it does not proxy requests or serve traffic." style="html=0;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#172c43;overflow=visible;rounded=1;arcSize=16;fillColor=#eaf0f7;strokeColor=none;spacingLeft=15;align=left;fontSize=13;fontColor=#28425e;fontSize=13;">
